<div class="container mt-4">
    <div class="row">
        <div class="col-8">
            <h2 class="text-primary">Listado de destinos disponibles </h2>
        </div>
        <div class="col-4 text-right">
            <a asp-action="Create" class="btn btn-secondary">Agregar nuevo destino</a>
        </div>
    </div>

    <table id="tblDestino" class="table table-striped table-bordered" style="width:100%">
        <thead>
            <tr>
                <th>
                    Id
                </th>
                <th>
                    Nombre
                </th>                
                <th>
                    Precio
                </th>
                <th>
                    Acciones
                </th>
            </tr>

        </thead>
    </table>

</div>

@section Scripts{
    <script src="~/js/destino.js"></script>
}

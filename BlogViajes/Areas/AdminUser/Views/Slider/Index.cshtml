@{
    ViewData["Title"] = "Vista Slider";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-8">
            <h2 class="text-primary">Slider</h2>
        </div>
        <div class="col-4 text-right">
            <a asp-action="Create" class="btn btn-secondary">Agregar un nuevo Slider</a>
        </div>
    </div>

    <table id="tblSlider" class="table table-striped table-bordered" style="width:100%">
        <thead>
            <tr>
                <th>
                    Id
                </th>
                <th>
                    Nombre
                </th>
                <th>
                    Estado
                </th>
                <th>
                    Imagen
                </th>
                <th>
                    Acciones
                </th>
            </tr>

        </thead>
    </table>
</div>

@section Scripts{
    <script src="~/js/slider.js"></script>
} 

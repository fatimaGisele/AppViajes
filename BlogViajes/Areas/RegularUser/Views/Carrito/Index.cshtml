@model BlogViajesModelo.ViewModels.CarritoView;
@{
    ViewData["Title"] = "Tu Carrito";
}
<br />
<br />
<h2 class="text-center text-white bg-primary mb-4">Tu Carrito</h2>
@if (Model.carrito.Detalles == null || !Model.carrito.Detalles.Any())
{
    <div class="text-center alert alert-info">
        <h4>No tenes paquetes de viajes en tu carrito</h4>
    </div>
}
else
{
    <div class="container mt-4">
        <table id="tblAgregarAlCarrito" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>
                        Paquete
                    </th>
                    <th>
                        Precio Unitario
                    </th>
                    <th>
                        Cantidad
                    </th>
                    <th>
                        Total
                    </th>
                </tr>

            </thead>
        </table>
        <br />
       
        <form asp-action="FinalizarCompra" method="post" class="col-3">
           
            <button type="submit" class="btn btn-primary mt-3">Finalizar Compra</button>
        </form>
        <br />

        <div class="col-3 ">
            <a asp-action="Index" asp-controller="Home" asp-area="RegularUser" class="btn btn-danger  mt-3 text-white form-control">Volver atras</a>
        </div>
      
    </div>
}

@section Scripts {
    <script src="~/js/carritoCliente.js"></script>
}

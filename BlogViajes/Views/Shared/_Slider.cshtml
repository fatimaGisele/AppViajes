@* <--slider--!> *@
<div id="carouselExampleControlsNoTouching" class="carousel slide" data-bs-touch="false">
    <div class="carousel-inner">
        
        <div class="carousel-item active">
            <img src="/imagenes/sliders/0ea3303a-55a6-4708-b93c-5efb943a0314.JPG" class="d-block w-100" alt="...">
        </div>
        <div class="carousel-item">
            <img src="/imagenes/sliders/95c92ea2-58a7-44c5-b901-fd91d9b259b2.JPG" class="d-block w-100" alt="...">
        </div>
        <div class="carousel-item">
            <img src="/imagenes/sliders/fb20c30e-707f-4286-88fc-7e6ba0a8d7d2.JPG" class="d-block w-100" alt="...">
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControlsNoTouching" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
